return function(ctx)
	local mk, tw, udim2, vec2, rgb, getText, gui = ctx.mk, ctx.tw, ctx.udim2, ctx.vec2, ctx.rgb, ctx.getText, ctx.gui

	local notifyContainer = gui:FindFirstChild("NotifyContainer")
	if not notifyContainer then
		notifyContainer = mk("Frame", {
			Name = "NotifyContainer",
			Size = udim2(0, 320, 1, -20),
			Position = udim2(0.5, 0, 1, -20),
			AnchorPoint = vec2(0.5, 1),
			BackgroundTransparency = 1,
			ZIndex = 3000000,
			Active = false
		}, gui)

		mk("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Center
		}, notifyContainer)
	end

	local function notify(config)
		config = type(config) == "table" and config or {Text = tostring(config)}
		local title = getText(config.Title or {ru = "УВЕДОМЛЕНИЕ", en = "NOTIFICATION"}, ctx.currentLang)
		local desc = getText(config.Text or config.Description or "", ctx.currentLang)
		local duration = config.Duration or 3

		local itemHolder = mk("Frame", {
			Size = udim2(1, 0, 0, 56),
			BackgroundTransparency = 1,
			ZIndex = 3000001
		}, notifyContainer)

		local notifFrame = mk("Frame", {
			Size = udim2(1, 0, 1, 0),
			Position = udim2(0, 0, 0, 30),
			BackgroundColor3 = rgb(16, 16, 22),
			BackgroundTransparency = 0.15,
			ClipsDescendants = true,
			ZIndex = 3000002
		}, itemHolder)

		mk("UICorner", {CornerRadius = UDim.new(0, 8)}, notifFrame)
		local stroke = mk("UIStroke", {Color = rgb(45, 45, 60), Thickness = 1, Transparency = 1}, notifFrame)

		local content = mk("Frame", {
			Size = udim2(1, 0, 1, 0),
			BackgroundTransparency = 1,
			ZIndex = 3000003
		}, notifFrame)

		local titleLabel = mk("TextLabel", {
			Size = udim2(1, -24, 0, 16),
			Position = udim2(0, 12, 0, 9),
			BackgroundTransparency = 1,
			Text = string.upper(title),
			TextColor3 = rgb(240, 240, 245),
			TextTransparency = 1,
			TextSize = 11,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 3000004
		}, content)

		local descLabel = mk("TextLabel", {
			Size = udim2(1, -24, 0, 22),
			Position = udim2(0, 12, 0, 26),
			BackgroundTransparency = 1,
			Text = desc,
			TextColor3 = rgb(160, 160, 175),
			TextTransparency = 1,
			TextSize = 11,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			ZIndex = 3000004
		}, content)

		local bottomBorderBg = mk("Frame", {
			Size = udim2(1, 0, 0, 2),
			Position = udim2(0, 0, 1, -2),
			BackgroundTransparency = 1,
			ZIndex = 3000005
		}, notifFrame)

		local bottomBorder = mk("Frame", {
			Size = udim2(1, 0, 1, 0),
			Position = udim2(0, 0, 0, 0),
			BackgroundColor3 = rgb(255, 255, 255),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 3000006
		}, bottomBorderBg)

		tw(notifFrame, 0.4, {
			Position = udim2(0, 0, 0, 0)
		}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

		tw(stroke, 0.35, {Transparency = 0})
		tw(titleLabel, 0.35, {TextTransparency = 0})
		tw(descLabel, 0.35, {TextTransparency = 0})
		tw(bottomBorder, 0.35, {BackgroundTransparency = 0})

		tw(bottomBorder, duration, {Size = udim2(0, 0, 1, 0)}, Enum.EasingStyle.Linear)

		task.delay(duration, function()
			if notifFrame and notifFrame.Parent then
				tw(stroke, 0.2, {Transparency = 1})
				tw(titleLabel, 0.15, {TextTransparency = 1})
				tw(descLabel, 0.15, {TextTransparency = 1})
				tw(bottomBorder, 0.15, {BackgroundTransparency = 1})

				tw(notifFrame, 0.3, {
					Size = udim2(0, 0, 0, 0),
					BackgroundTransparency = 1
				}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

				tw(itemHolder, 0.3, {
					Size = udim2(1, 0, 0, 0)
				}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

				task.wait(0.3)
				itemHolder:Destroy()
			end
		end)
	end

	return {
		Notify = notify,
		Send = notify
	}
end
