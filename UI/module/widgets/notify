return function(ctx)
	local mk, tw, udim2, vec2, rgb, getText, gui, RS = ctx.mk, ctx.tw, ctx.udim2, ctx.vec2, ctx.rgb, ctx.getText, ctx.gui, game:GetService("RunService")
	local cos, sin, atan2, deg, clamp = math.cos, math.sin, math.atan2, math.deg, math.clamp

	local notifyContainer = gui:FindFirstChild("NotifyContainer")
	if not notifyContainer then
		notifyContainer = mk("Frame", {
			Name = "NotifyContainer",
			Size = udim2(0, 320, 1, -20),
			Position = udim2(0.5, 0, 1, -20),
			AnchorPoint = vec2(0.5, 1),
			BackgroundTransparency = 1,
			ZIndex = 3000000,
			Active = false
		}, gui)

		mk("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Center
		}, notifyContainer)
	end

	local function attachParticles(parentContainer, baseZIndex)
		local NUM_NODES, MAX_DIST, nodes, linesPool, rng = 12, 55, {}, {}, Random.new()
		baseZIndex = baseZIndex or parentContainer.ZIndex

		for i = 1, NUM_NODES do
			local sz = rng:NextNumber(1.5, 2.5)
			local dot = mk("Frame", {
				Size = udim2(0, sz, 0, sz),
				AnchorPoint = vec2(0.5, 0.5),
				BackgroundColor3 = rgb(255, 255, 255),
				BackgroundTransparency = 1,
				ZIndex = baseZIndex
			}, parentContainer)
			mk("UICorner", {CornerRadius = UDim.new(1, 0)}, dot)
			local speed, angle = rng:NextNumber(10, 25), rng:NextNumber(0, math.pi * 2)
			nodes[i] = {
				frame = dot,
				pos = vec2(rng:NextNumber(0, 1), rng:NextNumber(0, 1)),
				vel = vec2(cos(angle) * speed, sin(angle) * speed),
				maxAlpha = rng:NextNumber(0.35, 0.7),
				offset = rng:NextNumber(0, 50),
				spd = rng:NextNumber(2, 4),
				screenPos = vec2(0, 0)
			}
		end

		local function getLine(idx)
			if not linesPool[idx] then
				linesPool[idx] = mk("Frame", {
					AnchorPoint = vec2(0.5, 0.5),
					BackgroundColor3 = rgb(255, 255, 255),
					ZIndex = baseZIndex
				}, parentContainer)
			end
			return linesPool[idx]
		end

		local globalFade, timeAcc, isDestroyed, conn = 1, 0, false, nil

		conn = RS.RenderStepped:Connect(function(dt)
			if isDestroyed or not parentContainer.Parent or not gui.Parent then
				if conn then conn:Disconnect() end
				return
			end
			timeAcc = timeAcc + dt
			local w, h = parentContainer.AbsoluteSize.X, parentContainer.AbsoluteSize.Y
			if w <= 0 or h <= 0 then return end

			for i = 1, #nodes do
				local n = nodes[i]
				local px, py = n.pos.X * w + n.vel.X * dt, n.pos.Y * h + n.vel.Y * dt
				if px < 0 or px > w then n.vel = vec2(-n.vel.X, n.vel.Y) px = clamp(px, 0, w) end
				if py < 0 or py > h then n.vel = vec2(n.vel.X, -n.vel.Y) py = clamp(py, 0, h) end
				n.pos, n.screenPos = vec2(px / w, py / h), vec2(px, py)
				n.frame.Position = udim2(0, px, 0, py)
				n.frame.BackgroundTransparency = 1 - (n.maxAlpha * (0.6 + ((sin(timeAcc * n.spd + n.offset) + 1) / 2) * 0.4) * globalFade)
			end

			local lineIdx = 0
			for i = 1, #nodes do
				local p1 = nodes[i].screenPos
				for j = i + 1, #nodes do
					local p2 = nodes[j].screenPos
					local diff = p2 - p1
					local dist = diff.Magnitude
					if dist < MAX_DIST then
						lineIdx = lineIdx + 1
						local line = getLine(lineIdx)
						line.Size, line.Position, line.Rotation = udim2(0, dist, 0, 1), udim2(0, (p1.X + p2.X) / 2, 0, (p1.Y + p2.Y) / 2), deg(atan2(diff.Y, diff.X))
						line.BackgroundTransparency = 1 - ((1 - (dist / MAX_DIST)) * 0.25 * globalFade)
						line.Visible = true
					end
				end
			end
			for k = lineIdx + 1, #linesPool do linesPool[k].Visible = false end
		end)

		return {
			setFade = function(v) globalFade = clamp(v, 0, 1) end,
			destroy = function()
				isDestroyed = true
				if conn then conn:Disconnect() end
				for _, n in ipairs(nodes) do if n.frame then n.frame:Destroy() end end
				for _, l in ipairs(linesPool) do if l then l:Destroy() end end
				nodes, linesPool = {}, {}
			end
		}
	end

	local function notify(config)
		config = type(config) == "table" and config or {Text = tostring(config)}
		local title = getText(config.Title or {ru = "УВЕДОМЛЕНИЕ", en = "NOTIFICATION"}, ctx.currentLang)
		local desc = getText(config.Text or config.Description or "", ctx.currentLang)
		local duration = config.Duration or 3

		local itemHolder = mk("Frame", {
			Size = udim2(1, 0, 0, 58),
			BackgroundTransparency = 1,
			ZIndex = 3000001
		}, notifyContainer)

		local notifFrame = mk("Frame", {
			Size = udim2(1, 0, 1, 0),
			Position = udim2(0, 0, 0, 30),
			BackgroundColor3 = rgb(10, 10, 12),
			BackgroundTransparency = 0.05,
			ClipsDescendants = true,
			ZIndex = 3000002
		}, itemHolder)

		mk("UICorner", {CornerRadius = UDim.new(0, 8)}, notifFrame)

		local particleContainer = mk("Frame", {
			Size = udim2(1, 0, 1, 0),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 3000003
		}, notifFrame)

		local particles = attachParticles(particleContainer, 3000003)

		local content = mk("Frame", {
			Size = udim2(1, 0, 1, 0),
			BackgroundTransparency = 1,
			ZIndex = 3000004
		}, notifFrame)

		local titleLabel = mk("TextLabel", {
			Size = udim2(1, -24, 0, 16),
			Position = udim2(0, 12, 0, 9),
			BackgroundTransparency = 1,
			Text = string.upper(title),
			TextColor3 = rgb(255, 255, 255),
			TextTransparency = 1,
			TextSize = 11,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 3000005
		}, content)

		local descLabel = mk("TextLabel", {
			Size = udim2(1, -24, 0, 22),
			Position = udim2(0, 12, 0, 26),
			BackgroundTransparency = 1,
			Text = desc,
			TextColor3 = rgb(180, 180, 195),
			TextTransparency = 1,
			TextSize = 11,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			ZIndex = 3000005
		}, content)

		local strokeContainer = mk("Frame", {
			Size = udim2(1, 0, 1, 0),
			BackgroundTransparency = 1,
			ZIndex = 3000006
		}, notifFrame)

		local topBorder = mk("Frame", {
			Size = udim2(1, 0, 0, 1),
			Position = udim2(0.5, 0, 0, 0),
			AnchorPoint = vec2(0.5, 0),
			BackgroundColor3 = rgb(255, 255, 255),
			BackgroundTransparency = 1,
			ZIndex = 3000007
		}, strokeContainer)

		local leftBorder = mk("Frame", {
			Size = udim2(0, 1, 1, 0),
			Position = udim2(0, 0, 0, 0),
			BackgroundColor3 = rgb(255, 255, 255),
			BackgroundTransparency = 1,
			ZIndex = 3000007
		}, strokeContainer)

		local rightBorder = mk("Frame", {
			Size = udim2(0, 1, 1, 0),
			Position = udim2(1, -1, 0, 0),
			BackgroundColor3 = rgb(255, 255, 255),
			BackgroundTransparency = 1,
			ZIndex = 3000007
		}, strokeContainer)

		local btmLeftBorder = mk("Frame", {
			Size = udim2(0.5, 0, 0, 1),
			Position = udim2(0, 0, 1, -1),
			BackgroundColor3 = rgb(255, 255, 255),
			BackgroundTransparency = 1,
			ZIndex = 3000007
		}, strokeContainer)

		local btmRightBorder = mk("Frame", {
			Size = udim2(0.5, 0, 0, 1),
			Position = udim2(1, 0, 1, -1),
			AnchorPoint = vec2(1, 0),
			BackgroundColor3 = rgb(255, 255, 255),
			BackgroundTransparency = 1,
			ZIndex = 3000007
		}, strokeContainer)

		tw(notifFrame, 0.4, {
			Position = udim2(0, 0, 0, 0)
		}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

		tw(titleLabel, 0.35, {TextTransparency = 0})
		tw(descLabel, 0.35, {TextTransparency = 0})

		tw(topBorder, 0.35, {BackgroundTransparency = 0.3})
		tw(leftBorder, 0.35, {BackgroundTransparency = 0.3})
		tw(rightBorder, 0.35, {BackgroundTransparency = 0.3})
		tw(btmLeftBorder, 0.35, {BackgroundTransparency = 0.3})
		tw(btmRightBorder, 0.35, {BackgroundTransparency = 0.3})

		tw(topBorder, duration * 0.25, {Size = udim2(0, 0, 0, 1)}, Enum.EasingStyle.Linear).Completed:Connect(function()
			tw(leftBorder, duration * 0.35, {Size = udim2(0, 1, 0, 0), Position = udim2(0, 0, 1, 0)}, Enum.EasingStyle.Linear)
			tw(rightBorder, duration * 0.35, {Size = udim2(0, 1, 0, 0), Position = udim2(1, -1, 1, 0)}, Enum.EasingStyle.Linear).Completed:Connect(function()
				tw(btmLeftBorder, duration * 0.4, {Size = udim2(0, 0, 0, 1), Position = udim2(0.5, 0, 1, -1)}, Enum.EasingStyle.Linear)
				tw(btmRightBorder, duration * 0.4, {Size = udim2(0, 0, 0, 1), Position = udim2(0.5, 0, 1, -1)}, Enum.EasingStyle.Linear)
			end)
		end)

		task.delay(duration, function()
			if notifFrame and notifFrame.Parent then
				if particles then particles.setFade(0) end

				tw(titleLabel, 0.15, {TextTransparency = 1})
				tw(descLabel, 0.15, {TextTransparency = 1})
				tw(topBorder, 0.15, {BackgroundTransparency = 1})
				tw(leftBorder, 0.15, {BackgroundTransparency = 1})
				tw(rightBorder, 0.15, {BackgroundTransparency = 1})
				tw(btmLeftBorder, 0.15, {BackgroundTransparency = 1})
				tw(btmRightBorder, 0.15, {BackgroundTransparency = 1})

				tw(notifFrame, 0.3, {
					Size = udim2(0, 0, 0, 0),
					BackgroundTransparency = 1
				}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

				tw(itemHolder, 0.3, {
					Size = udim2(1, 0, 0, 0)
				}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

				task.wait(0.3)
				if particles then particles.destroy() end
				itemHolder:Destroy()
			end
		end)
	end

	return {
		Notify = notify,
		Send = notify
	}
end
