return function(ctx)
	local mk, tw, udim2, vec2, rgb = ctx.mk, ctx.tw, ctx.udim2, ctx.vec2, ctx.rgb
	local makeBox, getText = ctx.makeBox, ctx.getText

	local function createToggleCore(parentFrame, textData, textWidthOffset, swSize, swPos, knobSize, knobPosOn, knobPosOff, defaultState, callback)
		local state = defaultState or false
		local title = getText(textData, ctx.currentLang)

		mk("TextLabel", {
			Size = udim2(1, textWidthOffset, 1, 0),
			Position = udim2(0, 8, 0, 0),
			BackgroundTransparency = 1,
			Text = title,
			TextColor3 = rgb(220, 220, 230),
			TextSize = 12,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 2000008
		}, parentFrame)

		local overlay = mk("TextButton", {
			Size = udim2(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 2000010
		}, parentFrame)

		local swBg = mk("Frame", {
			Size = swSize,
			AnchorPoint = vec2(1, 0.5),
			Position = swPos,
			BackgroundColor3 = state and rgb(25, 175, 100) or rgb(45, 45, 55),
			ZIndex = 2000008
		}, parentFrame)
		mk("UICorner", {CornerRadius = UDim.new(1, 0)}, swBg)

		local knob = mk("Frame", {
			Size = knobSize,
			AnchorPoint = vec2(0, 0.5),
			Position = state and knobPosOn or knobPosOff,
			BackgroundColor3 = rgb(255, 255, 255),
			BorderSizePixel = 0,
			ZIndex = 2000009
		}, swBg)
		mk("UICorner", {CornerRadius = UDim.new(1, 0)}, knob)

		overlay.MouseButton1Click:Connect(function()
			if ctx.isClosing() then return end
			state = not state
			tw(swBg, 0.15, {BackgroundColor3 = state and rgb(25, 175, 100) or rgb(45, 45, 55)})
			tw(knob, 0.15, {Position = state and knobPosOn or knobPosOff})
			if callback then callback(state) end
		end)

		return overlay
	end

	return {
		AddToggle = function(parent, config, defaultState, callback)
			local textData = config
			local defState = defaultState
			local cb = callback

			if type(config) == "table" and (config.ru or config.en or config.Text or config.Default ~= nil) then
				textData = config
				defState = config.Default ~= nil and config.Default or (type(defaultState) == "boolean" and defaultState or false)
				cb = config.Callback or callback or (type(defaultState) == "function" and defaultState or nil)
			end

			local frame, _, setHover = makeBox(parent, udim2(1, -10, 0, 36))
			local overlay = createToggleCore(frame, textData, -50, udim2(0, 36, 0, 20), udim2(1, -8, 0.5, 0), udim2(0, 16, 0, 16), udim2(1, -18, 0.5, 0), udim2(0, 2, 0.5, 0), defState, cb)
			overlay.MouseEnter:Connect(function() setHover(true) end)
			overlay.MouseLeave:Connect(function() setHover(false) end)
		end,

		AddDualToggle = function(parent, text1, default1, callback1, text2, default2, callback2)
			local rowFrame = mk("Frame", {Size = udim2(1, -10, 0, 36), BackgroundTransparency = 1, ZIndex = 2000007}, parent)

			local f1, _, h1 = makeBox(rowFrame, udim2(0.5, -4, 1, 0), udim2(0, 0, 0, 0), vec2(0, 0))
			local o1 = createToggleCore(f1, text1, -46, udim2(0, 30, 0, 16), udim2(1, -6, 0.5, 0), udim2(0, 12, 0, 12), udim2(1, -14, 0.5, 0), udim2(0, 2, 0.5, 0), default1, callback1)
			o1.MouseEnter:Connect(function() h1(true) end)
			o1.MouseLeave:Connect(function() h1(false) end)

			local f2, _, h2 = makeBox(rowFrame, udim2(0.5, -4, 1, 0), udim2(1, 0, 0, 0), vec2(1, 0))
			local o2 = createToggleCore(f2, text2, -46, udim2(0, 30, 0, 16), udim2(1, -6, 0.5, 0), udim2(0, 12, 0, 12), udim2(1, -14, 0.5, 0), udim2(0, 2, 0.5, 0), default2, callback2)
			o2.MouseEnter:Connect(function() h2(true) end)
			o2.MouseLeave:Connect(function() h2(false) end)
		end
	}
end
