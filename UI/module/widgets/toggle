return function(ctx)
	local mk, tw, udim2, vec2, rgb, makeBox, getText = ctx.mk, ctx.tw, ctx.udim2, ctx.vec2, ctx.rgb, ctx.makeBox, ctx.getText

	local Module = {}

	local function parseToggleConfig(arg1, arg2, arg3)
		if type(arg1) == "table" and (arg1.ru or arg1.en or arg1.Text) then
			return {
				Text = getText(arg1.Text or arg1, ctx.currentLang),
				Default = arg1.Default or false,
				Callback = arg1.Callback or function() end
			}
		else
			return {
				Text = getText(arg1, ctx.currentLang),
				Default = arg2 or false,
				Callback = type(arg3) == "function" and arg3 or function() end
			}
		end
	end

	function Module.AddToggle(parent, config1, def, cb)
		local cfg = parseToggleConfig(config1, def, cb)
		local enabled = cfg.Default

		local box, stroke, hoverFn = makeBox(parent, udim2(1, -10, 0, 36))

		local label = mk("TextLabel", {
			Size = udim2(1, -50, 1, 0),
			Position = udim2(0, 12, 0, 0),
			BackgroundTransparency = 1,
			Text = cfg.Text,
			TextColor3 = rgb(220, 220, 235),
			TextSize = 13,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 2000008
		}, box)

		local switchBg = mk("Frame", {
			Size = udim2(0, 36, 0, 20),
			AnchorPoint = vec2(1, 0.5),
			Position = udim2(1, -10, 0.5, 0),
			BackgroundColor3 = enabled and rgb(30, 215, 120) or rgb(40, 40, 50),
			ZIndex = 2000008
		}, box)
		mk("UICorner", {CornerRadius = UDim.new(1, 0)}, switchBg)

		local dot = mk("Frame", {
			Size = udim2(0, 14, 0, 14),
			AnchorPoint = vec2(0, 0.5),
			Position = enabled and udim2(1, -17, 0.5, 0) or udim2(0, 3, 0.5, 0),
			BackgroundColor3 = rgb(255, 255, 255),
			ZIndex = 2000009
		}, switchBg)
		mk("UICorner", {CornerRadius = UDim.new(1, 0)}, dot)

		local btn = mk("TextButton", { Size = udim2(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 2000010 }, box)

		local function updateToggle(val)
			enabled = val
			tw(switchBg, 0.2, { BackgroundColor3 = enabled and rgb(30, 215, 120) or rgb(40, 40, 50) })
			tw(dot, 0.2, { Position = enabled and udim2(1, -17, 0.5, 0) or udim2(0, 3, 0.5, 0) })
			cfg.Callback(enabled)
		end

		btn.MouseEnter:Connect(function() hoverFn(true) end)
		btn.MouseLeave:Connect(function() hoverFn(false) end)
		btn.MouseButton1Click:Connect(function() updateToggle(not enabled) end)

		return box
	end

	function Module.AddDualToggle(parent, config1, def1, cb1, config2, def2, cb2)
		local cfgA = parseToggleConfig(config1, def1, cb1)
		local cfgB = parseToggleConfig(config2, def2, cb2)

		local container = mk("Frame", { Size = udim2(1, -10, 0, 36), BackgroundTransparency = 1, ZIndex = 2000007 }, parent)
		Module.AddToggle(container, cfgA)
		Module.AddToggle(container, cfgB)

		return container
	end

	return Module
end
