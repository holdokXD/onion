return function(ctx)
	local mk, tw, udim2, vec2, rgb, makeBox, getText, UIS, clamp = ctx.mk, ctx.tw, ctx.udim2, ctx.vec2, ctx.rgb, ctx.makeBox, ctx.getText, ctx.UIS, math.clamp

	local Module = {}

	local function parseSliderConfig(arg1, arg2, arg3, arg4, arg5)
		if type(arg1) == "table" and (arg1.ru or arg1.en or arg1.Text) then
			return {
				Text = getText(arg1.Text or arg1, ctx.currentLang),
				Min = arg1.Min or 0,
				Max = arg1.Max or 100,
				Default = arg1.Default or arg1.Min or 0,
				Callback = arg1.Callback or function() end
			}
		else
			return {
				Text = getText(arg1, ctx.currentLang),
				Min = arg2 or 0,
				Max = arg3 or 100,
				Default = arg4 or arg2 or 0,
				Callback = type(arg5) == "function" and arg5 or function() end
			}
		end
	end

	function Module.AddSlider(parent, config1, min, max, def, cb)
		local cfg = parseSliderConfig(config1, min, max, def, cb)
		local val = clamp(cfg.Default, cfg.Min, cfg.Max)

		local box, stroke, hoverFn = makeBox(parent, udim2(1, -10, 0, 48))

		local label = mk("TextLabel", {
			Size = udim2(0.6, 0, 0, 20),
			Position = udim2(0, 12, 0, 6),
			BackgroundTransparency = 1,
			Text = cfg.Text,
			TextColor3 = rgb(220, 220, 235),
			TextSize = 12,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 2000008
		}, box)

		local valLabel = mk("TextLabel", {
			Size = udim2(0.3, 0, 0, 20),
			Position = udim2(1, -12, 0, 6),
			AnchorPoint = vec2(1, 0),
			BackgroundTransparency = 1,
			Text = tostring(val),
			TextColor3 = rgb(160, 160, 175),
			TextSize = 12,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 2000008
		}, box)

		local track = mk("Frame", {
			Size = udim2(1, -24, 0, 6),
			Position = udim2(0, 12, 1, -12),
			BackgroundColor3 = rgb(40, 40, 50),
			ZIndex = 2000008
		}, box)
		mk("UICorner", {CornerRadius = UDim.new(1, 0)}, track)

		local fill = mk("Frame", {
			Size = udim2((val - cfg.Min) / (cfg.Max - cfg.Min), 0, 1, 0),
			BackgroundColor3 = rgb(30, 215, 120),
			ZIndex = 2000009
		}, track)
		mk("UICorner", {CornerRadius = UDim.new(1, 0)}, fill)

		local dragging = false

		local function updateSlider(input)
			local alpha = clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			val = math.floor(cfg.Min + (cfg.Max - cfg.Min) * alpha)
			valLabel.Text = tostring(val)
			tw(fill, 0.05, { Size = udim2(alpha, 0, 1, 0) })
			cfg.Callback(val)
		end

		box.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				ctx.setActiveSliderInput(true)
				updateSlider(input)
			end
		end)

		UIS.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				updateSlider(input)
			end
		end)

		UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
				ctx.setActiveSliderInput(nil)
			end
		end)

		return box
	end

	return Module
end
