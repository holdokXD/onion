return function(ctx)
	local mk, tw, udim2, vec2, rgb, makeBox, getText = ctx.mk, ctx.tw, ctx.udim2, ctx.vec2, ctx.rgb, ctx.makeBox, ctx.getText

	local Module = {}

	local function parseDropdownConfig(arg1, arg2, arg3, arg4)
		if type(arg1) == "table" and (arg1.ru or arg1.en or arg1.Text) then
			return {
				Text = getText(arg1.Text or arg1, ctx.currentLang),
				Options = arg1.Options or {},
				Default = arg1.Default,
				Callback = arg1.Callback or function() end
			}
		else
			return {
				Text = getText(arg1, ctx.currentLang),
				Options = arg2 or {},
				Default = arg3,
				Callback = type(arg4) == "function" and arg4 or function() end
			}
		end
	end

	function Module.AddDropdown(parent, config1, opts, def, cb)
		local cfg = parseDropdownConfig(config1, opts, def, cb)
		local selected = cfg.Default or (cfg.Options[1] and getText(cfg.Options[1], ctx.currentLang)) or ""
		local isOpen = false

		local box, stroke, hoverFn = makeBox(parent, udim2(1, -10, 0, 38))
		box.ClipsDescendants = true

		local label = mk("TextLabel", {
			Size = udim2(0.5, 0, 0, 38),
			Position = udim2(0, 12, 0, 0),
			BackgroundTransparency = 1,
			Text = cfg.Text,
			TextColor3 = rgb(220, 220, 235),
			TextSize = 13,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 2000008
		}, box)

		local valLabel = mk("TextLabel", {
			Size = udim2(0.4, -20, 0, 38),
			Position = udim2(1, -28, 0, 0),
			AnchorPoint = vec2(1, 0),
			BackgroundTransparency = 1,
			Text = getText(selected, ctx.currentLang),
			TextColor3 = rgb(30, 215, 120),
			TextSize = 12,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 2000008
		}, box)

		local arrow = mk("TextLabel", {
			Size = udim2(0, 20, 0, 38),
			Position = udim2(1, -8, 0, 0),
			AnchorPoint = vec2(1, 0),
			BackgroundTransparency = 1,
			Text = "v",
			TextColor3 = rgb(140, 140, 155),
			TextSize = 12,
			Font = Enum.Font.GothamBold,
			ZIndex = 2000008
		}, box)

		local listContainer = mk("Frame", {
			Size = udim2(1, -16, 0, #cfg.Options * 28),
			Position = udim2(0, 8, 0, 38),
			BackgroundTransparency = 1,
			ZIndex = 2000009
		}, box)

		mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, listContainer)

		for i, opt in ipairs(cfg.Options) do
			local optText = getText(opt, ctx.currentLang)
			local optBtn = mk("TextButton", {
				Size = udim2(1, 0, 0, 26),
				BackgroundColor3 = rgb(30, 30, 38),
				BackgroundTransparency = 0.5,
				Text = optText,
				TextColor3 = (optText == getText(selected, ctx.currentLang)) and rgb(255, 255, 255) or rgb(160, 160, 175),
				TextSize = 12,
				Font = Enum.Font.GothamMedium,
				LayoutOrder = i,
				ZIndex = 2000010
			}, listContainer)
			mk("UICorner", { CornerRadius = UDim.new(0, 6) }, optBtn)

			optBtn.MouseButton1Click:Connect(function()
				selected = optText
				valLabel.Text = optText
				isOpen = false
				tw(box, 0.2, { Size = udim2(1, -10, 0, 38) })
				tw(arrow, 0.2, { Rotation = 0 })
				cfg.Callback(optText)
			end)
		end

		local triggerBtn = mk("TextButton", { Size = udim2(1, 0, 0, 38), BackgroundTransparency = 1, Text = "", ZIndex = 2000011 }, box)
		triggerBtn.MouseButton1Click:Connect(function()
			isOpen = not isOpen
			local targetH = isOpen and (42 + #cfg.Options * 28) or 38
			tw(box, 0.25, { Size = udim2(1, -10, 0, targetH) })
			tw(arrow, 0.2, { Rotation = isOpen and 180 or 0 })
		end)

		return box
	end

	return Module
end
