return function(ctx)
	local mk, tw, udim2, rgb = ctx.mk, ctx.tw, ctx.udim2, ctx.rgb
	local makeBox, getText = ctx.makeBox, ctx.getText

	local searchPlaceholders = { ru = "Поиск...", en = "Search..." }
	local noneText = { ru = "Ничего", en = "None" }

	local function buildDropdownContainer(parent, textData, initialText)
		local open = false
		local title = getText(textData, ctx.currentLang)
		local frame, _, setHover = makeBox(parent, udim2(1, -10, 0, 38))
		frame.ClipsDescendants = true

		local header = mk("TextButton", {Size = udim2(1, 0, 0, 38), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 2000010}, frame)
		mk("TextLabel", {Size = udim2(0.4, -10, 1, 0), Position = udim2(0, 8, 0, 0), BackgroundTransparency = 1, Text = title, TextColor3 = rgb(220, 220, 230), TextSize = 12, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2000008}, header)
		local valLabel = mk("TextLabel", {Size = udim2(0.6, -25, 1, 0), Position = udim2(0.4, 0, 0, 0), BackgroundTransparency = 1, Text = initialText, TextColor3 = rgb(160, 160, 175), TextSize = 11, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 2000008}, header)
		local arrow = mk("TextLabel", {Size = udim2(0, 20, 1, 0), Position = udim2(1, -22, 0, 0), BackgroundTransparency = 1, Text = "v", TextColor3 = rgb(160, 160, 175), TextSize = 10, Font = Enum.Font.GothamBold, ZIndex = 2000008}, header)

		local dropBody = mk("Frame", {Size = udim2(1, -16, 0, 140), Position = udim2(0, 8, 0, 38), BackgroundTransparency = 1, ZIndex = 2000008}, frame)
		local searchBox = mk("TextBox", {
			Size = udim2(1, 0, 0, 24), Position = udim2(0, 0, 0, 0),
			BackgroundColor3 = rgb(25, 25, 30), BackgroundTransparency = 0.5, Text = "",
			PlaceholderText = getText(searchPlaceholders, ctx.currentLang),
			TextColor3 = rgb(220, 220, 230), PlaceholderColor3 = rgb(120, 120, 135),
			TextSize = 13, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, ZIndex = 2000009
		}, dropBody)
		mk("UICorner", {CornerRadius = UDim.new(0, 6)}, searchBox)
		mk("UIStroke", {Color = rgb(45, 45, 55), Thickness = 1}, searchBox)
		mk("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)}, searchBox)

		local scroll = mk("ScrollingFrame", {Size = udim2(1, 0, 1, -30), Position = udim2(0, 0, 0, 30), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = udim2(0, 0, 0, 0), ZIndex = 2000009}, dropBody)
		local layout = mk("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3)}, scroll)

		local function updateCanvas()
			scroll.CanvasSize = udim2(0, 0, 0, layout.AbsoluteContentSize.Y + 2)
		end
		layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)

		header.MouseButton1Click:Connect(function()
			if ctx.isClosing() then return end
			open = not open
			tw(arrow, 0.25, {Rotation = open and 180 or 0})
			tw(frame, 0.25, {Size = udim2(1, -10, 0, open and 184 or 38)})
		end)

		header.MouseEnter:Connect(function() setHover(true) end)
		header.MouseLeave:Connect(function() setHover(false) end)

		return frame, header, valLabel, searchBox, scroll, function(query, btns)
			query = string.lower(query)
			for _, itemData in ipairs(btns) do
				local optText = string.lower(itemData.dispText)
				itemData.btn.Visible = (query == "" or string.find(optText, query, 1, true) ~= nil)
			end
			updateCanvas()
		end
	end

	return {
		AddDropdown = function(parent, config, options, defaultOption, callback)
			local textData = config
			local opts = options
			local defOpt = defaultOption
			local cb = callback

			if type(config) == "table" and (config.ru or config.en or config.Text or config.Options) then
				textData = config
				opts = config.Options or options or {}
				defOpt = config.Default or defaultOption or opts[1] or ""
				cb = config.Callback or callback or (type(options) == "function" and options or nil)
			end

			local selectedOpt = defOpt or opts[1] or ""
			local selectedText = getText(selectedOpt, ctx.currentLang)

			local _, _, valLabel, searchBox, scroll, filterOptions = buildDropdownContainer(parent, textData, selectedText)
			local btnList = {}

			local function updateBtnStyle(optRaw, btn)
				local isSel = (optRaw == selectedOpt or getText(optRaw, ctx.currentLang) == selectedText)
				btn.BackgroundTransparency = 1
				tw(btn, 0.12, {TextColor3 = isSel and rgb(255, 255, 255) or rgb(140, 140, 155)})
			end

			for i, opt in ipairs(opts) do
				local dispText = getText(opt, ctx.currentLang)
				local btn = mk("TextButton", {Size = udim2(1, 0, 0, 24), Text = "  " .. dispText, TextSize = 11, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, AutoButtonColor = false, LayoutOrder = i, ZIndex = 2000009}, scroll)
				mk("UICorner", {CornerRadius = UDim.new(0, 6)}, btn)

				table.insert(btnList, { opt = opt, btn = btn, dispText = dispText })
				updateBtnStyle(opt, btn)

				btn.MouseButton1Click:Connect(function()
					if ctx.isClosing() then return end
					selectedOpt = opt
					selectedText = dispText
					valLabel.Text = selectedText
					for _, item in ipairs(btnList) do updateBtnStyle(item.opt, item.btn) end
					if cb then cb(dispText) end
				end)
			end

			searchBox:GetPropertyChangedSignal("Text"):Connect(function() filterOptions(searchBox.Text, btnList) end)
		end,

		AddMultiDropdown = function(parent, config, options, defaultSelected, callback)
			local textData = config
			local opts = options
			local defSel = defaultSelected
			local cb = callback

			if type(config) == "table" and (config.ru or config.en or config.Text or config.Options) then
				textData = config
				opts = config.Options or options or {}
				defSel = config.Default or defaultSelected or {}
				cb = config.Callback or callback or (type(options) == "function" and options or nil)
			end

			local selectedMap = {}
			if type(defSel) == "table" then
				for _, v in ipairs(defSel) do
					local strVal = getText(v, ctx.currentLang)
					selectedMap[strVal] = true
				end
			end

			local _, _, valLabel, searchBox, scroll, filterOptions = buildDropdownContainer(parent, textData, "")
			local btnList = {}

			local function getSelectedList()
				local list = {}
				for _, item in ipairs(btnList) do
					if selectedMap[item.dispText] then table.insert(list, item.dispText) end
				end
				return list
			end

			local function updateText()
				local list = getSelectedList()
				valLabel.Text = #list > 0 and table.concat(list, ", ") or getText(noneText, ctx.currentLang)
			end

			local function updateBtnStyle(dispText, btn)
				local active = selectedMap[dispText] or false
				btn.BackgroundTransparency = 1
				btn.Text = "  " .. dispText
				tw(btn, 0.12, {TextColor3 = active and rgb(255, 255, 255) or rgb(140, 140, 155)})
			end

			for i, opt in ipairs(opts) do
				local dispText = getText(opt, ctx.currentLang)
				local btn = mk("TextButton", {Size = udim2(1, 0, 0, 24), TextSize = 11, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, AutoButtonColor = false, LayoutOrder = i, ZIndex = 2000009}, scroll)
				mk("UICorner", {CornerRadius = UDim.new(0, 6)}, btn)

				table.insert(btnList, { opt = opt, btn = btn, dispText = dispText })
				updateBtnStyle(dispText, btn)

				btn.MouseButton1Click:Connect(function()
					if ctx.isClosing() then return end
					selectedMap[dispText] = not selectedMap[dispText]
					updateBtnStyle(dispText, btn)
					updateText()
					if cb then cb(getSelectedList()) end
				end)
			end

			updateText()
			searchBox:GetPropertyChangedSignal("Text"):Connect(function() filterOptions(searchBox.Text, btnList) end)
		end
	}
end
