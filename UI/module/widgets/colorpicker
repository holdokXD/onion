return function(ctx)
	local mk, tw, udim2, vec2, rgb, makeBox, getText = ctx.mk, ctx.tw, ctx.udim2, ctx.vec2, ctx.rgb, ctx.makeBox, ctx.getText

	local Module = {}

	local function parseColorConfig(arg1, arg2, arg3)
		if type(arg1) == "table" and (arg1.ru or arg1.en or arg1.Text) then
			return {
				Text = getText(arg1.Text or arg1, ctx.currentLang),
				Default = arg1.Default or rgb(255, 255, 255),
				Callback = arg1.Callback or function() end
			}
		else
			return {
				Text = getText(arg1, ctx.currentLang),
				Default = arg2 or rgb(255, 255, 255),
				Callback = type(arg3) == "function" and arg3 or function() end
			}
		end
	end

	function Module.AddColorPicker(parent, config1, defColor, cb)
		local cfg = parseColorConfig(config1, defColor, cb)
		local currentColor = cfg.Default

		local box, stroke, hoverFn = makeBox(parent, udim2(1, -10, 0, 38))

		local label = mk("TextLabel", {
			Size = udim2(1, -60, 1, 0),
			Position = udim2(0, 12, 0, 0),
			BackgroundTransparency = 1,
			Text = cfg.Text,
			TextColor3 = rgb(220, 220, 235),
			TextSize = 13,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 2000008
		}, box)

		local preview = mk("Frame", {
			Size = udim2(0, 24, 0, 24),
			AnchorPoint = vec2(1, 0.5),
			Position = udim2(1, -10, 0.5, 0),
			BackgroundColor3 = currentColor,
			ZIndex = 2000008
		}, box)
		mk("UICorner", { CornerRadius = UDim.new(0, 6) }, preview)
		mk("UIStroke", { Color = rgb(60, 60, 75), Thickness = 1 }, preview)

		local btn = mk("TextButton", { Size = udim2(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 2000010 }, box)
		btn.MouseButton1Click:Connect(function()
			currentColor = (currentColor == cfg.Default) and rgb(255, 80, 80) or cfg.Default
			tw(preview, 0.2, { BackgroundColor3 = currentColor })
			cfg.Callback(currentColor)
		end)

		return box
	end

	return Module
end
