return function(ctx)
	local mk, tw, udim2, rgb, makeBox, getText = ctx.mk, ctx.tw, ctx.udim2, ctx.rgb, ctx.makeBox, ctx.getText

	local Module = {}

	local function parseButtonConfig(arg1, arg2)
		if type(arg1) == "table" and (arg1.ru or arg1.en or arg1.Text or arg1.Callback) then
			return {
				Text = getText(arg1.Text or arg1, ctx.currentLang),
				Callback = arg1.Callback or function() end
			}
		else
			return {
				Text = getText(arg1, ctx.currentLang),
				Callback = type(arg2) == "function" and arg2 or function() end
			}
		end
	end

	function Module.AddBtn(parent, config1, config2)
		local cfg = parseButtonConfig(config1, config2)
		local box, stroke, hoverFn = makeBox(parent, udim2(1, -10, 0, 34))

		local btn = mk("TextButton", {
			Size = udim2(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = cfg.Text,
			TextColor3 = rgb(220, 220, 235),
			TextSize = 13,
			Font = Enum.Font.GothamMedium,
			AutoButtonColor = false,
			ZIndex = 2000008
		}, box)

		btn.MouseEnter:Connect(function() hoverFn(true) end)
		btn.MouseLeave:Connect(function() hoverFn(false) end)
		btn.MouseButton1Click:Connect(function()
			tw(box, 0.08, { Size = udim2(1, -14, 0, 32) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			task.wait(0.08)
			tw(box, 0.12, { Size = udim2(1, -10, 0, 34) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			cfg.Callback()
		end)

		return box
	end

	function Module.AddDualBtn(parent, config1, cb1, config2, cb2)
		local cfgA = parseButtonConfig(config1, cb1)
		local cfgB = parseButtonConfig(config2, cb2)

		local container = mk("Frame", { Size = udim2(1, -10, 0, 34), BackgroundTransparency = 1, ZIndex = 2000007 }, parent)
		local box1, stroke1, hover1 = makeBox(container, udim2(0.485, 0, 1, 0), udim2(0, 0, 0, 0))
		local box2, stroke2, hover2 = makeBox(container, udim2(0.485, 0, 1, 0), udim2(1, 0, 0, 0), Vector2.new(1, 0))

		local btn1 = mk("TextButton", { Size = udim2(1, 0, 1, 0), BackgroundTransparency = 1, Text = cfgA.Text, TextColor3 = rgb(220, 220, 235), TextSize = 12, Font = Enum.Font.GothamMedium, AutoButtonColor = false, ZIndex = 2000008 }, box1)
		local btn2 = mk("TextButton", { Size = udim2(1, 0, 1, 0), BackgroundTransparency = 1, Text = cfgB.Text, TextColor3 = rgb(220, 220, 235), TextSize = 12, Font = Enum.Font.GothamMedium, AutoButtonColor = false, ZIndex = 2000008 }, box2)

		btn1.MouseEnter:Connect(function() hover1(true) end)
		btn1.MouseLeave:Connect(function() hover1(false) end)
		btn1.MouseButton1Click:Connect(function() cfgA.Callback() end)

		btn2.MouseEnter:Connect(function() hover2(true) end)
		btn2.MouseLeave:Connect(function() hover2(false) end)
		btn2.MouseButton1Click:Connect(function() cfgB.Callback() end)

		return container
	end

	return Module
end
