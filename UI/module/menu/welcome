return function(ctx)
	local mk, tw, udim2, vec2, rgb = ctx.mk, ctx.tw, ctx.udim2, ctx.vec2, ctx.rgb or rgb
	local TS = game:GetService("TweenService")
	local Module = {}

	local langTexts = {
		EN = {
			title = "MAIN MENU", subStart = "Select an option to continue", subPass = "Enter password to access",
			subErr = "Incorrect password, try again", start = "Start", leave = "Leave", langBtn = "English",
			passHolder = "Enter Password", submit = "Submit", back = "Back", loading = "LOADING MODULES...", complete = "LOAD COMPLETE!"
		},
		RU = {
			title = "ГЛАВНОЕ МЕНЮ", subStart = "Выберите параметр для продолжения", subPass = "Введите пароль для доступа",
			subErr = "Неверный пароль, попробуйте еще раз", start = "Старт", leave = "Выход", langBtn = "Русский",
			passHolder = "Введите пароль", submit = "Отправить", back = "Назад", loading = "ЗАГРУЗКА МОДУЛЕЙ...", complete = "ЗАГРУЗКА ЗАВЕРШЕНА!"
		}
	}

	local function smoothTween(inst, dur, props, style, dir)
		local info = TweenInfo.new(dur or 0.3, style or Enum.EasingStyle.Sine, dir or Enum.EasingDirection.Out)
		local t = TS:Create(inst, info, props)
		t:Play()
		return t
	end

	local function createBtn(txt, clr, parent, order)
		local btn = mk("TextButton", {
			Size = udim2(0, 220, 0, 44), AnchorPoint = vec2(0.5, 0.5), BackgroundColor3 = clr, BackgroundTransparency = 1,
			Text = txt, TextColor3 = rgb(255, 255, 255), TextTransparency = 1, TextSize = 15, Font = Enum.Font.GothamBold,
			AutoButtonColor = false, Modal = true, LayoutOrder = order or 1, ZIndex = 1000005
		}, parent)
		mk("UICorner", { CornerRadius = UDim.new(0, 10) }, btn)
		return btn
	end

	local function bindHover(btn, norm, hover)
		btn.MouseEnter:Connect(function()
			if btn.Visible and btn.TextTransparency < 0.2 and not (ctx.isClosing and ctx.isClosing()) then
				smoothTween(btn, 0.2, { BackgroundColor3 = hover })
			end
		end)
		btn.MouseLeave:Connect(function()
			if btn.Visible and not (ctx.isClosing and ctx.isClosing()) then
				smoothTween(btn, 0.2, { BackgroundColor3 = norm })
			end
		end)
	end

	function Module.CreateAuthMenu(parent, config)
		config = config or {}
		local password = config.password or "1234"
		local currentLang = config.defaultLang or "EN"
		local onSuccess, onLeave = config.onSuccess or function() end, config.onLeave or function() game:Shutdown() end
		local isTransitioning = false

		if config.customTexts then
			for l, map in pairs(config.customTexts) do
				langTexts[l] = langTexts[l] or {}
				for k, v in pairs(map) do langTexts[l][k] = v end
			end
		end

		local card = mk("Frame", { Size = udim2(0, 270, 0, 280), AnchorPoint = vec2(0.5, 0.5), Position = udim2(0.5, 0, 0.5, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1000000 }, parent)

		local title = mk("TextLabel", { Size = udim2(1, 0, 0, 30), AnchorPoint = vec2(0.5, 0.5), Position = udim2(0.5, 0, 0, 22), BackgroundTransparency = 1, Text = langTexts[currentLang].title, TextColor3 = rgb(255, 255, 255), TextTransparency = 1, TextSize = 20, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 1000005 }, card)
		local subTitle = mk("TextLabel", { Size = udim2(1, 0, 0, 20), AnchorPoint = vec2(0.5, 0.5), Position = udim2(0.5, 0, 0, 48), BackgroundTransparency = 1, Text = langTexts[currentLang].subStart, TextColor3 = rgb(140, 140, 155), TextTransparency = 1, TextSize = 12, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 1000005 }, card)

		local mainContainer = mk("Frame", { Size = udim2(1, 0, 0, 200), AnchorPoint = vec2(0.5, 0), Position = udim2(0.5, 0, 0, 72), BackgroundTransparency = 1, ZIndex = 1000005, Visible = true }, card)
		mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center }, mainContainer)

		local startBtn = createBtn(langTexts[currentLang].start, rgb(25, 175, 100), mainContainer, 1)
		local leaveBtn = createBtn(langTexts[currentLang].leave, rgb(215, 35, 55), mainContainer, 2)
		local langBtn  = createBtn(langTexts[currentLang].langBtn, rgb(60, 60, 75), mainContainer, 3)

		local passContainer = mk("Frame", { Size = udim2(1, 0, 0, 200), AnchorPoint = vec2(0.5, 0), Position = udim2(0.5, 0, 0, 72), BackgroundTransparency = 1, ZIndex = 1000005, Visible = false }, card)
		mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center }, passContainer)

		local passInput = mk("TextBox", { Size = udim2(0, 220, 0, 44), AnchorPoint = vec2(0.5, 0.5), BackgroundColor3 = rgb(20, 20, 25), BackgroundTransparency = 1, Text = "", PlaceholderText = langTexts[currentLang].passHolder, PlaceholderColor3 = rgb(0, 0, 0), TextColor3 = rgb(255, 255, 255), TextTransparency = 1, TextSize = 14, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Center, ClearTextOnFocus = false, LayoutOrder = 1, ZIndex = 1000006 }, passContainer)
		mk("UICorner", { CornerRadius = UDim.new(0, 10) }, passInput)

		local submitBtn = createBtn(langTexts[currentLang].submit, rgb(25, 175, 100), passContainer, 2)
		local backBtn   = createBtn(langTexts[currentLang].back, rgb(60, 60, 75), passContainer, 3)

		bindHover(startBtn, rgb(25, 175, 100), rgb(30, 200, 115))
		bindHover(leaveBtn, rgb(215, 35, 55), rgb(245, 45, 65))
		bindHover(langBtn, rgb(60, 60, 75), rgb(80, 80, 95))
		bindHover(submitBtn, rgb(25, 175, 100), rgb(30, 200, 115))
		bindHover(backBtn, rgb(60, 60, 75), rgb(80, 80, 95))

		smoothTween(title, 0.4, { TextTransparency = 0 })
		smoothTween(subTitle, 0.4, { TextTransparency = 0 })
		smoothTween(startBtn, 0.4, { TextTransparency = 0, BackgroundTransparency = 0 })
		smoothTween(leaveBtn, 0.4, { TextTransparency = 0, BackgroundTransparency = 0 })
		smoothTween(langBtn, 0.4, { TextTransparency = 0, BackgroundTransparency = 0 })

		local function changeText(lbl, txt, clr)
			local tOut = smoothTween(lbl, 0.15, { TextTransparency = 1 })
			tOut.Completed:Connect(function()
				lbl.Text = txt
				if clr then lbl.TextColor3 = clr end
				smoothTween(lbl, 0.2, { TextTransparency = 0 })
			end)
		end

		langBtn.MouseButton1Click:Connect(function()
			if isTransitioning then return end
			isTransitioning = true
			currentLang = (currentLang == "EN") and "RU" or "EN"
			local t = langTexts[currentLang]

			smoothTween(startBtn, 0.15, { TextTransparency = 1 })
			smoothTween(leaveBtn, 0.15, { TextTransparency = 1 })
			smoothTween(langBtn, 0.15, { TextTransparency = 1 })
			changeText(title, t.title)
			changeText(subTitle, t.subStart, rgb(140, 140, 155))

			task.wait(0.16)
			startBtn.Text, leaveBtn.Text, langBtn.Text = t.start, t.leave, t.langBtn
			passInput.PlaceholderText, submitBtn.Text, backBtn.Text = t.passHolder, t.submit, t.back

			smoothTween(startBtn, 0.2, { TextTransparency = 0 })
			smoothTween(leaveBtn, 0.2, { TextTransparency = 0 })
			smoothTween(langBtn, 0.2, { TextTransparency = 0 })
			task.wait(0.2)
			isTransitioning = false
		end)

		startBtn.MouseButton1Click:Connect(function()
			if isTransitioning then return end
			isTransitioning = true

			smoothTween(startBtn, 0.2, { TextTransparency = 1, BackgroundTransparency = 1 })
			smoothTween(leaveBtn, 0.2, { TextTransparency = 1, BackgroundTransparency = 1 })
			smoothTween(langBtn, 0.2, { TextTransparency = 1, BackgroundTransparency = 1 })
			changeText(subTitle, langTexts[currentLang].subPass, rgb(140, 140, 155))

			task.wait(0.2)
			mainContainer.Visible = false
			passContainer.Visible = true

			passInput.BackgroundTransparency = 1
			passInput.TextTransparency = 1
			passInput.PlaceholderColor3 = rgb(0, 0, 0)
			submitBtn.BackgroundTransparency = 1
			submitBtn.TextTransparency = 1
			backBtn.BackgroundTransparency = 1
			backBtn.TextTransparency = 1

			smoothTween(passInput, 0.25, { BackgroundTransparency = 0, TextTransparency = 0, PlaceholderColor3 = rgb(120, 120, 135) })
			smoothTween(submitBtn, 0.25, { BackgroundTransparency = 0, TextTransparency = 0 })
			smoothTween(backBtn, 0.25, { BackgroundTransparency = 0, TextTransparency = 0 })

			task.wait(0.25)
			isTransitioning = false
		end)

		backBtn.MouseButton1Click:Connect(function()
			if isTransitioning then return end
			isTransitioning = true

			smoothTween(passInput, 0.2, { BackgroundTransparency = 1, TextTransparency = 1, PlaceholderColor3 = rgb(0, 0, 0) })
			smoothTween(submitBtn, 0.2, { BackgroundTransparency = 1, TextTransparency = 1 })
			smoothTween(backBtn, 0.2, { BackgroundTransparency = 1, TextTransparency = 1 })
			changeText(subTitle, langTexts[currentLang].subStart, rgb(140, 140, 155))

			task.wait(0.2)
			passContainer.Visible = false
			passInput.Text = ""
			mainContainer.Visible = true

			startBtn.BackgroundTransparency = 1
			startBtn.TextTransparency = 1
			leaveBtn.BackgroundTransparency = 1
			leaveBtn.TextTransparency = 1
			langBtn.BackgroundTransparency = 1
			langBtn.TextTransparency = 1

			smoothTween(startBtn, 0.25, { BackgroundTransparency = 0, TextTransparency = 0 })
			smoothTween(leaveBtn, 0.25, { BackgroundTransparency = 0, TextTransparency = 0 })
			smoothTween(langBtn, 0.25, { BackgroundTransparency = 0, TextTransparency = 0 })

			task.wait(0.25)
			isTransitioning = false
		end)

		leaveBtn.MouseButton1Click:Connect(onLeave)

		submitBtn.MouseButton1Click:Connect(function()
			if isTransitioning then return end
			if passInput.Text == password then
				isTransitioning = true
				smoothTween(title, 0.2, { TextTransparency = 1 })
				smoothTween(subTitle, 0.2, { TextTransparency = 1 })
				smoothTween(passInput, 0.2, { BackgroundTransparency = 1, TextTransparency = 1, PlaceholderColor3 = rgb(0, 0, 0) })
				smoothTween(submitBtn, 0.2, { BackgroundTransparency = 1, TextTransparency = 1 })
				smoothTween(backBtn, 0.2, { BackgroundTransparency = 1, TextTransparency = 1 })
				task.wait(0.22)
				onSuccess(card, currentLang, langTexts[currentLang])
			else
				changeText(subTitle, langTexts[currentLang].subErr, rgb(255, 70, 70))
				smoothTween(passInput, 0.05, { Position = udim2(0.5, 6, 0, 0) }).Completed:Connect(function()
					smoothTween(passInput, 0.05, { Position = udim2(0.5, -6, 0, 0) }).Completed:Connect(function()
						smoothTween(passInput, 0.05, { Position = udim2(0.5, 0, 0, 0) })
					end)
				end)
			end
		end)

		return { card = card, getCurrentLang = function() return currentLang end }
	end

	return Module
end
