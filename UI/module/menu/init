local CoreGui, Players, TS, RS, UIS = game:GetService("CoreGui"), game:GetService("Players"), game:GetService("TweenService"), game:GetService("RunService"), game:GetService("UserInputService")
local player = Players.LocalPlayer
local isClosing, activeSliderInput = false, nil
local vec2, udim2, rgb = Vector2.new, UDim2.new, Color3.fromRGB
local cos, sin, atan2, deg, clamp = math.cos, math.sin, math.atan2, math.deg, math.clamp

local function tw(o, t, p, s, d)
	local tween = TS:Create(o, TweenInfo.new(t or 0.35, s or Enum.EasingStyle.Quart, d or Enum.EasingDirection.Out), p)
	tween:Play()
	return tween
end

local function mk(cls, props, parent)
	local o = Instance.new(cls)
	if o:IsA("GuiObject") then o.BorderSizePixel = 0 end
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end

local function makeBox(parent, size, pos, anchor)
	local container = mk("Frame", {Size = size or udim2(1, -10, 0, 38), Position = pos, AnchorPoint = anchor, BackgroundColor3 = rgb(18, 18, 22), BackgroundTransparency = 0.5, ZIndex = 2000002, Active = false}, parent)
	mk("UICorner", {CornerRadius = UDim.new(0, 8)}, container)
	local stroke = mk("UIStroke", {Color = rgb(35, 35, 45), Thickness = 1}, container)
	return container, stroke, function(hover)
		if not isClosing then
			tw(container, 0.2, {BackgroundColor3 = hover and rgb(28, 28, 35) or rgb(18, 18, 22)})
			tw(stroke, 0.2, {Color = hover and rgb(55, 55, 70) or rgb(35, 35, 45)})
		end
	end
end

local function getText(val, currentLang)
	if type(val) == "table" then
		local key = string.lower(currentLang or "en")
		return tostring(val[key] or val[string.upper(key)] or val.en or val.EN or val.ru or val.RU or val.Text or val.text or select(2, next(val)) or "")
	end
	return tostring(val or "")
end

local function attachParticles(parentContainer, baseZIndex)
	local NUM_NODES, MAX_DIST, nodes, linesPool, rng = 35, 80, {}, {}, Random.new()
	baseZIndex = baseZIndex or parentContainer.ZIndex

	for i = 1, NUM_NODES do
		local sz = rng:NextNumber(1.5, 3)
		local dot = mk("Frame", {Size = udim2(0, sz, 0, sz), AnchorPoint = vec2(0.5, 0.5), BackgroundColor3 = rgb(255, 255, 255), BackgroundTransparency = 1, ZIndex = baseZIndex}, parentContainer)
		mk("UICorner", {CornerRadius = UDim.new(1, 0)}, dot)
		local speed, angle = rng:NextNumber(15, 35), rng:NextNumber(0, math.pi * 2)
		nodes[i] = {frame = dot, pos = vec2(rng:NextNumber(0, 1), rng:NextNumber(0, 1)), vel = vec2(cos(angle) * speed, sin(angle) * speed), maxAlpha = rng:NextNumber(0.35, 0.8), offset = rng:NextNumber(0, 50), spd = rng:NextNumber(2, 5), screenPos = vec2(0, 0)}
	end

	local function getLine(idx)
		if not linesPool[idx] then
			linesPool[idx] = mk("Frame", {AnchorPoint = vec2(0.5, 0.5), BackgroundColor3 = rgb(220, 230, 255), ZIndex = baseZIndex}, parentContainer)
		end
		return linesPool[idx]
	end

	local globalFade, timeAcc, isDestroyed, conn = 1, 0, false, nil

	conn = RS.RenderStepped:Connect(function(dt)
		if isDestroyed or not parentContainer.Parent then
			if conn then conn:Disconnect() end
			return
		end
		timeAcc = timeAcc + dt
		local w, h = parentContainer.AbsoluteSize.X, parentContainer.AbsoluteSize.Y
		if w <= 0 or h <= 0 then return end

		for i = 1, #nodes do
			local n = nodes[i]
			local px, py = n.pos.X * w + n.vel.X * dt, n.pos.Y * h + n.vel.Y * dt
			if px < 0 or px > w then n.vel = vec2(-n.vel.X, n.vel.Y) px = clamp(px, 0, w) end
			if py < 0 or py > h then n.vel = vec2(n.vel.X, -n.vel.Y) py = clamp(py, 0, h) end
			n.pos, n.screenPos = vec2(px / w, py / h), vec2(px, py)
			n.frame.Position = udim2(0, px, 0, py)
			n.frame.BackgroundTransparency = 1 - (n.maxAlpha * (0.6 + ((sin(timeAcc * n.spd + n.offset) + 1) / 2) * 0.4) * globalFade)
		end

		local lineIdx = 0
		for i = 1, #nodes do
			local p1 = nodes[i].screenPos
			for j = i + 1, #nodes do
				local p2 = nodes[j].screenPos
				local diff = p2 - p1
				local dist = diff.Magnitude
				if dist < MAX_DIST then
					lineIdx = lineIdx + 1
					local line = getLine(lineIdx)
					line.Size, line.Position, line.Rotation = udim2(0, dist, 0, 1), udim2(0, (p1.X + p2.X) / 2, 0, (p1.Y + p2.Y) / 2), deg(atan2(diff.Y, diff.X))
					line.BackgroundTransparency = 1 - ((1 - (dist / MAX_DIST)) * 0.25 * globalFade)
					line.Visible = true
				end
			end
		end
		for k = lineIdx + 1, #linesPool do linesPool[k].Visible = false end
	end)

	return {
		setFade = function(v) globalFade = clamp(v, 0, 1) end,
		destroy = function()
			isDestroyed = true
			if conn then conn:Disconnect() end
			for _, n in ipairs(nodes) do if n.frame then n.frame:Destroy() end end
			for _, l in ipairs(linesPool) do if l then l:Destroy() end end
			nodes, linesPool = {}, {}
		end
	}
end

local Library = {}

function Library.Load(cfg)
	cfg = cfg or {}
	local gui = mk("ScreenGui", {Name = "OptimizedGlowMenu", IgnoreGuiInset = true, ResetOnSpawn = false, DisplayOrder = 999999999})
	pcall(function() gui.Parent = CoreGui end)
	if not gui.Parent then gui.Parent = player:WaitForChild("PlayerGui") end

	local backdrop = mk("Frame", {Size = udim2(1, 0, 1, 0), BackgroundColor3 = rgb(0, 0, 0), ZIndex = 999999}, gui)
	local authParticles = attachParticles(backdrop, 1000002)

	local ctx = {
		mk = mk, tw = tw, udim2 = udim2, vec2 = vec2, rgb = rgb, makeBox = makeBox, UIS = UIS, gui = gui,
		currentLang = cfg.DefaultLang or "EN",
		getText = getText,
		attachParticles = attachParticles,
		isClosing = function() return isClosing end,
		setClosing = function(v) isClosing = v end,
		getActiveSliderInput = function() return activeSliderInput end,
		setActiveSliderInput = function(v) activeSliderInput = v end
	}

	local BASE_URL = "https://raw.githubusercontent.com/holdokXD/onion/main/UI/module/"
	local WIDGETS_URL = BASE_URL .. "widgets/"
	local MENU_URL = BASE_URL .. "menu/main"
	local WELCOME_URL = BASE_URL .. "menu/welcome"

	local function startLoading(card, currentLang, authLangTexts, callback)
		card.Visible = false
		local loaderFrame = mk("Frame", {Size = udim2(0, 320, 0, 90), AnchorPoint = vec2(0.5, 0.5), Position = udim2(0.5, 0, 0.5, 0), BackgroundTransparency = 1, ZIndex = 1000010}, backdrop)
		local loadStatus = mk("TextLabel", {Size = udim2(1, 0, 0, 20), BackgroundTransparency = 1, Text = authLangTexts.loading or "LOADING MODULES...", TextColor3 = rgb(255, 255, 255), TextTransparency = 1, TextSize = 14, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center}, loaderFrame)
		local loadDetail = mk("TextLabel", {Size = udim2(1, 0, 0, 18), Position = udim2(0, 0, 0, 22), BackgroundTransparency = 1, Text = "Initializing...", TextColor3 = rgb(140, 140, 155), TextTransparency = 1, TextSize = 11, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Center}, loaderFrame)
		
		local dotsContainer = mk("Frame", {Size = udim2(0, 60, 0, 12), Position = udim2(0.5, 0, 0, 50), AnchorPoint = vec2(0.5, 0), BackgroundTransparency = 1, ZIndex = 1000011}, loaderFrame)
		mk("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10), FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center}, dotsContainer)

		local dots = {}
		for i = 1, 3 do
			dots[i] = mk("Frame", {Size = udim2(0, 8, 0, 8), BackgroundColor3 = rgb(255, 255, 255), BackgroundTransparency = 0.8, LayoutOrder = i, ZIndex = 1000012}, dotsContainer)
			mk("UICorner", {CornerRadius = UDim.new(1, 0)}, dots[i])
		end

		tw(loadStatus, 0.3, {TextTransparency = 0})
		tw(loadDetail, 0.3, {TextTransparency = 0})

		local isLoadingModules = true
		task.spawn(function()
			local idx = 1
			while isLoadingModules do
				for i, dot in ipairs(dots) do
					tw(dot, 0.3, {Size = (i == idx) and udim2(0, 12, 0, 12) or udim2(0, 8, 0, 8), BackgroundTransparency = (i == idx) and 0 or 0.7})
				end
				idx = (idx % 3) + 1
				task.wait(0.35)
			end
		end)

		task.wait(0.3)

		local modulesToLoad = {
			{key = "button", name = "Buttons Module"},
			{key = "toggle", name = "Toggles Module"},
			{key = "slider", name = "Sliders Module"},
			{key = "dropdown", name = "Dropdowns Module"},
			{key = "colorpicker", name = "ColorPickers Module"},
			{key = "input", name = "Input Module"},
			{key = "label", name = "Label Module"},
			{key = "notify", name = "Notify Module"}
		}

		local loadedWidgets = {}
		for _, modInfo in ipairs(modulesToLoad) do
			loadDetail.Text = "Loading: " .. modInfo.name
			local success, result = pcall(function() return loadstring(game:HttpGet(WIDGETS_URL .. modInfo.key))()(ctx) end)
			loadedWidgets[modInfo.key] = success and result or {}
			task.wait(0.15)
		end

		isLoadingModules = false
		loadDetail.Text = authLangTexts.complete or "LOAD COMPLETE!"
		tw(loadStatus, 0.25, {TextColor3 = rgb(30, 215, 120)})

		for idx, dot in ipairs(dots) do
			task.delay((idx - 1) * 0.06, function()
				tw(dot, 0.25, {Size = udim2(0, 12, 0, 12), BackgroundTransparency = 0, BackgroundColor3 = rgb(30, 215, 120)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			end)
		end

		task.wait(0.4)
		if authParticles then authParticles.destroy() end
		backdrop:Destroy()

		local MenuModule = loadstring(game:HttpGet(MENU_URL))()(ctx)
		local menuApi = MenuModule.Init(loadedWidgets, currentLang)

		if callback then
			callback(menuApi, ctx)
		end
	end

	local WelcomeModule = loadstring(game:HttpGet(WELCOME_URL))()(ctx)
	WelcomeModule.CreateAuthMenu(backdrop, {
		password = cfg.Password or "1234",
		defaultLang = cfg.DefaultLang or "EN",
		onSuccess = function(card, currentLang, authLangTexts)
			startLoading(card, currentLang, authLangTexts, cfg.OnReady)
		end,
		onLeave = function()
			game:Shutdown()
		end
	})
end

return Library
